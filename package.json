{
  "name": "dsh-web-search-channels",
  "version": "0.1.0",
  "private": true,
  "description": "Replace DSH web search with the credentials of a channel you choose.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets/qoder/qoder-auth-wasm.wasm",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "verify-build": "node scripts/verify-build.mjs",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:integration && node scripts/verify-build.mjs && node scripts/verify-css-isolation.mjs && node scripts/verify-package.mjs",
    "prepare": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "31.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
